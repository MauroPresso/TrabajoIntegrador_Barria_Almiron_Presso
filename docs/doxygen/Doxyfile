# ============================================================
# Doxygen configuration - SistemaDeAerolinea
# Programacion II - IFES
# ============================================================

DOXYFILE_ENCODING       = UTF-8

PROJECT_NAME            = "SistemaDeAerolinea"
PROJECT_NUMBER          = "1.0-SNAPSHOT"
PROJECT_BRIEF           = "Programacion II academic project analogous to Biblioteca"

OUTPUT_LANGUAGE         = Spanish

OUTPUT_DIRECTORY        = docs/doxygen
CREATE_SUBDIRS          = NO
ALLOW_UNICODE_NAMES     = NO

INPUT_ENCODING          = UTF-8

INPUT                   = README.md \
                          docs/ARQUITECTURA.md \
                          docs/GUIA_ESTUDIO.md \
                          docs/doxygen/README.md \
                          src/main/java \
                          src/test/java

FILE_PATTERNS           = *.java *.md
RECURSIVE               = YES

EXCLUDE                 = target
EXCLUDE_PATTERNS        = */target/* \
                          */docs/doxygen/html/* \
                          */docs/doxygen/latex/* \
                          */docs/doxygen/xml/*

USE_MDFILE_AS_MAINPAGE  = README.md
MARKDOWN_SUPPORT        = YES
AUTOLINK_SUPPORT        = YES

OPTIMIZE_OUTPUT_JAVA    = YES
JAVADOC_AUTOBRIEF       = YES
MULTILINE_CPP_IS_BRIEF  = YES

# Complete code coverage in generated documentation.
EXTRACT_ALL             = YES
EXTRACT_PRIVATE         = YES
EXTRACT_STATIC          = YES
EXTRACT_LOCAL_CLASSES   = YES
EXTRACT_LOCAL_METHODS   = YES
HIDE_UNDOC_MEMBERS      = NO
HIDE_UNDOC_CLASSES      = NO

FULL_PATH_NAMES         = NO
STRIP_FROM_PATH         = src/main/java \
                          src/test/java

SOURCE_BROWSER          = YES
INLINE_SOURCES          = YES
STRIP_CODE_COMMENTS     = NO

REFERENCED_BY_RELATION  = YES
REFERENCES_RELATION     = YES

GENERATE_TODOLIST       = YES
GENERATE_TESTLIST       = YES
GENERATE_BUGLIST        = YES

WARNINGS                = YES
WARN_IF_UNDOCUMENTED    = NO
WARN_IF_DOC_ERROR       = YES
WARN_NO_PARAMDOC        = NO
WARN_LOGFILE            = docs/doxygen/doxygen-warnings.log

GENERATE_HTML           = YES
HTML_OUTPUT             = html
GENERATE_TREEVIEW       = YES
DISABLE_INDEX           = NO
SEARCHENGINE            = YES

GENERATE_LATEX          = NO
GENERATE_XML            = NO
GENERATE_RTF            = NO
GENERATE_MAN            = NO

# Keep setup simple and independent from Graphviz.
HAVE_DOT                = NO

QUIET                   = NO
